      "color": "#f472b6",
      "restBeats": 3,
      "steps": [
        {
          "to": "t_customers",
          "edgeId": "e_open",
          "label": "Customers",
          "detail": "inserted only when name and phone match nothing already there"
        },
        {
          "to": "t_orders",
          "edgeId": "e_c1",
          "label": "Orders",
          "detail": "the header · OUTPUT INSERTED hands back the OrderID everything else needs"
        },
        {
          "to": "t_log",
          "edgeId": "e_c2",
          "label": "OrdersLog",
          "detail": "one audit row against that OrderID"
        },
        {
          "to": "t_details",
          "edgeId": "e_c3",
          "label": "OrdersDetails",
          "detail": "one row per line, plus a comment row per modifier"
        },
        {
          "to": "t_tax",
          "edgeId": "e_c4",
          "label": "OrdersTax",
          "detail": "four buckets, filled or written as zero"
        },
        {
          "to": "t_delivery",
          "edgeId": "e_c5",
          "label": "OrdersDelivery",
          "detail": "pickup, delivery and shipping only — a dine-in order gets none"
        },
        {
          "to": "t_payments",
          "edgeId": "e_c6",
          "label": "Payments",
          "detail": "one tender · no CCTxs row, the synthesised card carries no last four"
        },
        {
          "to": "t_settle",
          "edgeId": "e_c7",
          "label": "Orders, again",
          "detail": "Paid, Status, CloseDate, BatchID · and no OrdersTips: the tip is zero"
        }
      ]
    }
