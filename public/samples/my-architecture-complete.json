    {
      "id": "w_443",
      "label": "Outbound TCP 443",
      "sublabel": "To the Central hostnames",
      "categoryId": "net",
      "icon": "🔐",
      "groupId": "g_egress",
      "x": -330,
      "y": 730,
      "width": 300,
      "height": 56,
      "info": "Carries: REST sync, auth, catalog, order catch-up\nDirection: opened by the Edge, never by Central\nProxy: allow-list the hostname, not an IP - the IP moves"
    },
    {
      "id": "w_9094",
      "label": "A connection held open for hours",
      "sublabel": "the price of pushing over 443",
      "categoryId": "net",
      "icon": "📡",
      "groupId": "g_egress",
      "x": -330,
      "y": 802,
      "width": 300,
      "height": 56,
      "info": "A subscription is one HTTP request that never finishes.\nNAT tables and proxies drop idle connections, so the stream sends a\nkeepalive, and the Edge reconnects with backoff from its last id"
    },
    {
      "id": "w_noin",
      "label": "No inbound, no VPN",
      "sublabel": "Nothing is forwarded at the store",
      "categoryId": "net",
      "icon": "🚫",
      "groupId": "g_egress",
      "x": -330,
      "y": 874,
      "width": 300,
      "height": 56,
      "info": "Central never dials the store.\nREST is Edge-initiated and Kafka is a consumer connection, so both go outward.\nSo: no port forwards, no static public IP, no site-to-site tunnel"
    },
    {
      "id": "w_dnsntp",
      "label": "DNS and NTP",
      "sublabel": "UDP/TCP 53 and UDP 123",
      "categoryId": "net",
      "icon": "🕑",
      "groupId": "g_egress",
      "x": -330,
      "y": 946,
      "width": 300,
      "height": 56,
      "info": "A captive resolver or split-horizon DNS will break hostname resolution.\nClock skew breaks TLS, token expiry, SASL and order timestamps.\nKeep the box within about a minute of real time"
    },
    {
      "id": "l_5200",
      "label": "Edge API on the LAN",
      "sublabel": "TCP 5200 from every device",
      "categoryId": "net",
      "icon": "🔌",
      "groupId": "g_lan",
      "x": 60,
      "y": 730,
      "width": 300,
      "height": 56,
      "info": "Devices, kiosks and the local dashboard all call the Edge on this port.\nGive the box a DHCP reservation or a static address - devices cache the host"
    },
    {
      "id": "l_mdns",
      "label": "Device discovery",
      "sublabel": "mDNS - UDP 5353",
      "categoryId": "net",
      "icon": "📡",
      "groupId": "g_lan",
      "x": 60,
      "y": 802,
      "width": 300,
      "height": 56,
      "info": "Multicast does not cross VLANs, and guest Wi-Fi client isolation drops it.\nPut devices and the Edge on one VLAN, or configure the host by hand"
    },
    {
      "id": "l_sql",
      "label": "Exatouch SQL Server",
      "sublabel": "TCP 1433 and UDP 1434",
      "categoryId": "net",
      "icon": "🪟",
      "groupId": "g_lan",
      "x": 60,
      "y": 874,
      "width": 300,
      "height": 56,
      "info": "The Edge writes orders straight into XTTDB, so it needs a route to that host.\n1434 is the SQL Browser - a named instance cannot be found without it.\nWindows Firewall must allow both, and TCP/IP must be on in SQL Configuration Manager"
    },
    {
      "id": "l_9100",
      "label": "Printers",
      "sublabel": "TCP 9100, raw",
      "categoryId": "net",
      "icon": "🖨️",
      "groupId": "g_lan",
      "x": 60,
      "y": 946,
      "width": 300,
      "height": 56,
      "info": "Receipt and kitchen printers are addressed directly by IP.\nSame VLAN as the Edge, and fixed addresses - a lease change stops printing silently"
    },
    {
      "id": "r_plain",
      "label": "Kafka never leaves Central",
      "sublabel": "no store connects to the broker",
      "categoryId": "security",
      "icon": "🔒",
      "groupId": "g_risk",
      "x": 450,
      "y": 730,
      "width": 300,
      "height": 56,
      "info": "Keeping the store's leg on 443 takes the broker off the public internet.\nIt still wants TLS between Central's own services.\nWhat it no longer needs is a broker credential on every shop-floor PC"
    },
    {
      "id": "r_tenant",
      "label": "Fan-out and replay are ours now",
      "sublabel": "Central owns what the broker used to",
      "categoryId": "security",
      "icon": "👥",
      "groupId": "g_risk",
      "x": 450,
      "y": 802,
      "width": 300,
      "height": 56,
      "info": "Isolation stops being an ACL and becomes a query: one queue per store.\nThat is the right place for it, but it is code we own.\nNeeds backpressure, and a jittered reconnect so a restart is not a stampede"
    },
    {
      "id": "r_tls",
      "label": "TLS interception",
      "sublabel": "UTM boxes and corporate proxies re-sign",
      "categoryId": "security",
      "icon": "🛡️",
      "groupId": "g_risk",
      "x": 450,
      "y": 874,
      "width": 300,
      "height": 56,
      "info": "A middlebox that re-signs traffic breaks the chain unless the Edge trusts its root CA.\nSo: never pin certificates, and prefer an exemption for the Central hosts"
    },
    {
      "id": "r_creds",
      "label": "Credential rotation",
      "sublabel": "Device keys sit on a shop-floor PC",
      "categoryId": "security",
      "icon": "🔑",
      "groupId": "g_risk",
      "x": 450,
      "y": 946,
      "width": 300,
      "height": 56,
      "info": "The device key lives on an unattended machine that strangers can walk up to.\nNeeded: rotate and revoke from Central with no site visit, and short-lived tokens"
    },
    {
      "id": "r_retention",
      "label": "How far back a store can catch up",
      "sublabel": "a Central decision now",
      "categoryId": "ops",
      "icon": "🗓️",
      "groupId": "g_risk",
      "x": 830,
      "y": 730,
      "width": 300,
      "height": 56,
      "info": "Retention is no longer a topic setting, it is how long the per-store queue\nis kept. It has to cover the longest outage we promise, and the order\nbackfill endpoint is the floor under it"
    },
    {
      "id": "r_ops",
      "label": "Updates and health, pull only",
      "sublabel": "You cannot dial in",
      "categoryId": "ops",
      "icon": "📈",
      "groupId": "g_risk",
      "x": 830,
      "y": 802,
      "width": 300,
      "height": 56,
      "info": "With no inbound path the Edge fetches its own updates and pushes its own heartbeat.\nWithout that, a store that stopped syncing is invisible until someone phones"
    },
    {
      "id": "r_cgnat",
      "label": "CGNAT and moving public IPs",
      "sublabel": "Do not allow-list the store",
      "categoryId": "ops",
      "icon": "🧭",
      "groupId": "g_risk",
      "x": 830,
      "y": 874,
      "width": 300,
      "height": 56,
      "info": "Store links are dynamic and often carrier-NAT'd, and stores can share one address.\nIdentity comes from the device key, never from the source IP"
    },
    {
      "id": "r_offline",
      "label": "When the link drops",
      "sublabel": "Keep selling",
      "categoryId": "ops",
      "icon": "✈️",
      "groupId": "g_risk",
      "x": 830,
      "y": 946,
      "width": 300,
      "height": 56,
      "info": "The Edge keeps taking orders, keeps writing into XTTDB, and queues everything locally.\nOn reconnect it drains the outbox and pulls what it missed.\nRehearse this on purpose before the first rollout"
    }
  ],
