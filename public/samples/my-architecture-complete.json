  "flows": [
    {
      "id": "fl_order",
      "label": "An online order reaches the store",
      "from": "n_customers",
      "color": "#38bdf8",
      "restBeats": 3,
      "steps": [
        {
          "to": "c_cdn",
          "edgeId": "e_shop",
          "label": "A shopper places an order",
          "detail": "HTTPS 443 to the hosted page"
        },
        {
          "to": "c_alb",
          "edgeId": "e_cdn_alb",
          "label": "The page calls the API",
          "detail": "same origin, /api"
        },
        {
          "to": "c_api",
          "edgeId": "e_alb_api",
          "label": "In through the public endpoint",
          "detail": "TLS terminates here"
        },
        {
          "to": "c_saga",
          "edgeId": "e_api_saga",
          "label": "The order saga runs",
          "detail": "validate, set status, notify the store, queue webhooks"
        },
        {
          "to": "c_kafka",
          "edgeId": "e_saga_kafka",
          "label": "notify_store publishes it",
          "detail": "topic pos.orders"
        },
        {
          "to": "c_stream",
          "edgeId": "e_stream",
          "label": "Central fans it out to that one store",
          "detail": "one queue per store, and one connection held open to drain it"
        },
        {
          "to": "c_alb",
          "edgeId": "e_alb_stream",
          "label": "Out through the same public endpoint",
          "detail": "port 443 · there is no second port to ask the merchant for"
        },
        {
          "to": "n_internet",
          "edgeId": "e_rest",
          "label": "Down to the store",
          "detail": "on the connection the Edge opened, so nothing is forwarded inward"
        },
        {
          "to": "n_fw",
          "edgeId": "e_wan",
          "label": "Back in through the store's NAT",
          "detail": "no inbound rule, no VPN, no static address"
        },
        {
          "to": "n_f64b9l5",
          "edgeId": "e_egress",
          "label": "To the Edge box on the shop floor",
          "detail": "its own port 5200 never leaves the LAN"
        },
        {
          "to": "n_dj7z1cp",
          "edgeId": "e_70opfl4",
          "label": "Written into Exatouch",
          "detail": "XtOrderWriter · one transaction, Orders through Payments"
        }
      ]
    }
  ]
